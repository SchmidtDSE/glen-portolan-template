{
    "titiler_url": "https://titiler.nrp-nautilus.io",
    "view": {
        "center": [
            -90.245,
            38.635
        ],
        "zoom": 11.2
    },
    "links": {
        "github": "https://github.com/SchmidtDSE/glen-portolan-template"
    },
    "default_basemap": "plain",
    "collections": [
        {
            "url": "https://data.source.coop/tge-labs/st-louis-open-data-mirror/urban-development-and-planning/neighborhoods/collection.json",
            "display_name": "Neighborhoods",
            "group": "Boundaries",
            "style": "styles/style-boundaries",
            "visible": true,
            "tooltip": [
                "NHD_NAME",
                "NHD_NUM"
            ]
        },
        {
            "url": "https://data.source.coop/tge-labs/st-louis-open-data-mirror/government/wards/collection.json",
            "display_name": "Wards (2020)",
            "group": "Boundaries",
            "style": "styles/style-boundaries",
            "tooltip": [
                "DISTRICT"
            ]
        },
        {
            "url": "https://data.source.coop/tge-labs/st-louis-open-data-mirror/demographics/holc-redlining/collection.json",
            "display_name": "HOLC redlining grades (1930s)",
            "group": "History",
            "tooltip": [
                "label",
                "grade",
                "category"
            ]
        },
        {
            "url": "https://data.source.coop/tge-labs/st-louis-open-data-mirror/housing/market-value-analysis/collection.json",
            "display_name": "Market value analysis (2024)",
            "group": "Housing",
            "visible": true,
            "tooltip": [
                "MVACluster",
                "MSP2123_CA",
                "PVacBuild"
            ]
        },
        {
            "url": "https://data.source.coop/tge-labs/st-louis-open-data-mirror/urban-development-and-planning/vacancy-composite/collection.json",
            "display_name": "Vacant parcels",
            "group": "Housing",
            "tooltip": [
                "STREET_ADD",
                "PROPERTY_T",
                "OWNER_NAME",
                "YEAR_BUILT"
            ]
        },
        {
            "url": "https://data.source.coop/tge-labs/st-louis-open-data-mirror/urban-development-and-planning/parcels/collection.json",
            "display_name": "Parcels by assessed value",
            "group": "Housing",
            "style": "styles/style-assessed-value",
            "tooltip": [
                "SITEADDR",
                "AsdTotal",
                "FirstYearBuilt",
                "Zoning"
            ]
        },
        {
            "url": "https://data.source.coop/tge-labs/st-louis-open-data-mirror/demographics/acs-tracts/collection.json",
            "display_name": "Census tracts (ACS)",
            "group": "People",
            "tooltip": [
                "geoid",
                "population",
                "median_hh_income",
                "pct_below_poverty"
            ]
        },
        {
            "url": "https://s3-west.nrp-nautilus.io/public-population/ghs-pop-2020/stac-collection.json",
            "display_name": "Population in 2020 (GHS-POP)",
            "group": "People",
            "colormap": "magma",
            "rescale": "0,60",
            "opacity": 0.8
        },
        {
            "url": "https://data.source.coop/tge-labs/st-louis-open-data-mirror/health/lead-service-lines/collection.json",
            "display_name": "Lead service lines",
            "group": "Health",
            "tooltip": [
                "address",
                "utilstatus_desc",
                "utilmaterial_desc"
            ]
        },
        {
            "url": "https://data.source.coop/tge-labs/st-louis-open-data-mirror/law-safety-and-justice/tornado-damage-2025/collection.json",
            "display_name": "May 2025 tornado damage",
            "group": "Hazards",
            "tooltip": [
                "efscale",
                "damage_txt",
                "windspeed"
            ]
        },
        {
            "url": "https://data.source.coop/tge-labs/st-louis-open-data-mirror/environment/floodplain/collection.json",
            "display_name": "Floodplain",
            "group": "Hazards",
            "style": "styles/style-sfha",
            "tooltip": [
                "FLD_ZONE",
                "SFHA_TF"
            ]
        }
    ],
    "sidebar": {
        "enabled": true,
        "title": "St. Louis open data",
        "chat_title": "Chat"
    },
    "plugins": [
        {
            "url": "https://cdn.jsdelivr.net/gh/SchmidtDSE/glen@v3.47.0/core/plugins/mcp.js",
            "options": {
                "servers": [
                    {
                        "worker": "plugins/geo-query-worker.js",
                        "worker_config": {
                            "discovery": false
                        },
                        "include": [
                            "query"
                        ]
                    }
                ]
            }
        }
    ],
    "auto_approve": true,
    "llm": {
        "user_provided": true,
        "default_endpoint": "https://openrouter.ai/api/v1",
        "models": [
            {
                "value": "~deepseek/deepseek-v4-flash-latest",
                "label": "DeepSeek V4 Flash"
            },
            {
                "value": "nvidia/nemotron-3.5-super-vl",
                "label": "Nemotron 3.5 Super"
            },
            {
                "value": "z-ai/glm-5.3-flash",
                "label": "GLM-5.3 Flash"
            },
            {
                "value": "minimax/minimax-m3.1-flash",
                "label": "MiniMax M3.1 Flash"
            }
        ]
    },
    "welcome": {
        "message": "I can show, filter and colour the layers on this map of St. Louis, and run SQL over their data in your browser. Try asking:",
        "examples": [
            "Show the 1930s redlining grades over the 2024 market value clusters",
            "Which ten neighborhoods have the most vacant parcels?",
            "How many people live in each ward, from the 2020 population grid?",
            "How many service lines are lead, and how many are still unknown?",
            "Show the May 2025 tornado damage coloured by EF scale and zoom to it"
        ]
    }
}
